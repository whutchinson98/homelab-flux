          "type": "postgres",
          "uid": "whoop-postgres"
        },
        "query": "SELECT DISTINCT user_id::text AS __text, user_id::text AS __value FROM (SELECT user_id FROM public.whoop_cycle_metrics UNION SELECT user_id FROM public.whoop_weight_observations) AS accounts ORDER BY __text;",
        "definition": "SELECT DISTINCT user_id::text AS __text, user_id::text AS __value FROM (SELECT user_id FROM public.whoop_cycle_metrics UNION SELECT user_id FROM public.whoop_weight_observations) AS accounts ORDER BY __text;",
