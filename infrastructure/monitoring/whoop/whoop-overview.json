      },
      "description": "One row per stored cycle. Missing and unscored values are distinct. Complete requires all expected metrics. No cycles are removed or merged by reporting date.",
      "datasource": {
        "type": "postgres",
        "uid": "whoop-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "whoop-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT time AS \"Cycle start\", cycle_id::text AS \"Cycle ID\", reporting_date::text AS \"Reporting date\",\n  reporting_timezone AS \"Reporting timezone\", cycle_quality AS \"Cycle\", recovery_quality AS \"Recovery\",\n  sleep_quality AS \"Sleep\", is_complete AS \"Complete\", recovery_missing AS \"Recovery missing\",\n  sleep_missing AS \"Sleep missing\", sleep_link_source AS \"Sleep link\", cycle_fetched_at AS \"Cycle fetched\"\nFROM public.whoop_cycle_metrics WHERE $__timeFilter(time) AND user_id = CAST(${user:sqlstring} AS bigint)\nORDER BY time DESC, cycle_id DESC;"
        }
