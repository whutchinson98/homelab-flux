    {
      "id": 3,
      "title": "Recovery",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "description": "Value from the latest cycle in the selected time range. An absent value stays absent; older non-null values are not substituted. Check the cycle quality below.",
      "datasource": {
        "type": "postgres",
        "uid": "whoop-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "whoop-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT recovery_pct AS \"Recovery\"\nFROM public.whoop_cycle_metrics\nWHERE $__timeFilter(time) AND user_id = CAST(${user:sqlstring} AS bigint)\nORDER BY time DESC, cycle_id DESC LIMIT 1;"
        }
      ],
      "fieldConfig": {
        "defaults": {
